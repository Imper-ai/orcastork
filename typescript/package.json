{
  "name": "orcastork",
  "version": "0.1.0",
  "description": "A dataflow orchestration framework: resumable, session-scoped graphs scheduled by data readiness.",
  "keywords": [
    "orchestration",
    "dataflow",
    "blackboard",
    "workflow",
    "ports-and-adapters"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Imper.AI <contact@imper.ai>",
  "homepage": "https://github.com/Imper-ai/orcastork",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Imper-ai/orcastork.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/Imper-ai/orcastork/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/orcastork/index.js",
  "types": "./dist/orcastork/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/orcastork/index.d.ts",
      "default": "./dist/orcastork/index.js"
    },
    "./lite": {
      "types": "./dist/orcastork_lite/index.d.ts",
      "default": "./dist/orcastork_lite/index.js"
    }
  },
  "bin": {
    "orcastork-lite-graph": "./dist/orcastork_lite/tools/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && tsc --noEmit",
    "fix_lint": "biome check --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "mongodb": "^7.6.0",
    "redis": "^6.2.1"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "~4.0.18",
    "mongodb": "^7.6.0",
    "mongodb-memory-server": "^11.2.0",
    "redis": "^6.2.1",
    "typescript": "^7.0.2",
    "vitest": "~4.0.18"
  }
}
